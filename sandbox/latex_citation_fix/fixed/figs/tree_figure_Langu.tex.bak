\draw[->] ($(L84.south west) + (2mm, 0)$) |- (l_84_3.west);


\node[nodeB, fill={teal!15}, anchor=north] (L87) at (87, 0) {NAR and hybrid schedules};
\begin{scope}[start chain=29 going below]
\chainin (L87) [on chain, join];
\node[nodeB, on chain, fill=blue!15, xshift=6mm, yshift=-7mm] (l_87_0) {Decode RVQ-1 autoregressively; predict higher RVQ levels in parallel to cut latency};
\node[nodeB, on chain, fill=blue!15] (l_87_1) {Preserve intelligibility while reducing exposure bias};
\node[nodeB, on chain, fill=blue!15] (l_87_2) {Best suited for S2ST and retrieval-augmented generation when codecs favor intelligibility};
\node[nodeB, on chain, fill=blue!15] (l_87_3) {Parallel residual prediction reduces wall-clock delay with minimal quality loss};

\end{scope}
\draw[->] ($(L87.south west) + (2mm, 0)$) |- (l_87_0.west);
\draw[->] ($(L87.south west) + (2mm, 0)$) |- (l_87_1.west);
