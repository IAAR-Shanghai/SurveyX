\node[nodeB, fill={teal!15}, anchor=north] (L81) at (81, 0) {Decoder regimes and objectives};
\begin{scope}[start chain=27 going below]
\chainin (L81) [on chain, join];
\node[nodeB, on chain, fill=blue!15, xshift=6mm, yshift=-7mm] (l_81_0) {Autoregressive (AR) over discrete codec/semantic tokens or continuous prompts};
\node[nodeB, on chain, fill=blue!15] (l_81_1) {Non-autoregressive (NAR) via masked infilling or multi-codebook heads};
\node[nodeB, on chain, fill=blue!15] (l_81_2) {AR+NAR hybrids: AR on low-entropy channels (e.g., RVQ-1), NAR on high-rate residuals};
\node[nodeB, on chain, fill=blue!15] (l_81_3) {Interleaved dual-token training with shared vocabulary and schedule-aware masking};
\node[nodeB, on chain, fill=blue!15] (l_81_4) {Token-conditioned diffusion/flow to recover prosody/timbre at low token rates};
\node[nodeB, on chain, fill=blue!15] (l_81_5) {Core trade-off: latency versus fidelity versus sequencing flexibility};

\end{scope}
\draw[->] ($(L81.south west) + (2mm, 0)$) |- (l_81_0.west);
\draw[->] ($(L81.south west) + (2mm, 0)$) |- (l_81_1.west);
\draw[->] ($(L81.south west) + (2mm, 0)$) |- (l_81_2.west);
\draw[->] ($(L81.south west) + (2mm, 0)$) |- (l_81_3.west);
\draw[->] ($(L81.south west) + (2mm, 0)$) |- (l_81_4.west);
\draw[->] ($(L81.south west) + (2mm, 0)$) |- (l_81_5.west);


\node[nodeB, fill={teal!15}, anchor=north] (L84) at (84, 0) {AR backbones and use cases};
\begin{scope}[start chain=28 going below]
\chainin (L84) [on chain, join];
\node[nodeB, on chain, fill=blue!15, xshift=6mm, yshift=-7mm] (l_84_0) {Textless unit LMs: quantize speech (e.g., HuBERT+k-means) and generate via unit LM + vocoder};
\node[nodeB, on chain, fill=blue!15] (l_84_1) {Duplex AR decoders: next audio token prediction conditioned on streaming listening embeddings (middle fusion)};
\node[nodeB, on chain, fill=blue!15] (l_84_2) {Decoder-only ASR: CTC-compressed prompts + sentinel tokens fed to causal decoder (joint CTC+CE training)};
\node[nodeB, on chain, fill=blue!15] (l_84_3) {Shared objective: single next-token decoder reasoning over text and speech};

\end{scope}
\draw[->] ($(L84.south west) + (2mm, 0)$) |- (l_84_0.west);
\draw[->] ($(L84.south west) + (2mm, 0)$) |- (l_84_1.west);
