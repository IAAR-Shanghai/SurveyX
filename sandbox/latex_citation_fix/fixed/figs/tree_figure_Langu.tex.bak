\node[nodeB, fill={teal!15}, anchor=north] (L90) at (90, 0) {Interleaved training and fidelity restoration};
\begin{scope}[start chain=30 going below]
\chainin (L90) [on chain, join];
\node[nodeB, on chain, fill=blue!15, xshift=6mm, yshift=-7mm] (l_90_0) {Unified text–speech vocabularies with modality sentinels and loss masking for mixed contexts};
\node[nodeB, on chain, fill=blue!15] (l_90_1) {Conditional flow/diffusion or vocoder tails to restore waveform fidelity};
\node[nodeB, on chain, fill=blue!15] (l_90_2) {Especially effective for semantic-only or ultra–low-rate tokens};
\node[nodeB, on chain, fill=blue!15] (l_90_3) {Single decoder handles text-only, speech-only, and mixed continuations};

\end{scope}
